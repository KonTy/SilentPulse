<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stock_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stock_card_light"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stock_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/stock_configure_title"
            android:textColor="#202124"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/stock_refresh"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:contentDescription="@string/stock_refresh"
            android:src="@drawable/ic_sync_black_24dp" />

        <ImageButton
            android:id="@+id/stock_settings"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:contentDescription="@string/stock_configure_title"
            android:src="@drawable/ic_settings_black_24dp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView
            android:id="@+id/stock_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />
        <TextView
            android:id="@+id/stock_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/stock_empty"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
