<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/world_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <TextClock
        android:id="@+id/world_clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10dp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeStepGranularity="1sp"
        android:shadowColor="#80000000"
        android:shadowRadius="2"
        android:shadowDy="1" />

    <ImageView
        android:id="@+id/world_clock_weather"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_weather_unavailable"
        android:contentDescription="@string/world_clock_weather_loading" />

    <TextView
        android:id="@+id/world_clock_city"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/world_clock_widget_name"
        android:textSize="8sp"
        android:textColor="@android:color/white"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:shadowColor="#80000000"
        android:shadowRadius="2"
        android:shadowDy="1" />
</LinearLayout>
