<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stock_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/stock_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/stock_detail_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/stock_detail_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/stock_detail_loading_quote"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/stock_detail_change"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/stock_detail_quote_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/stock_detail_quote_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:accessibilityLiveRegion="polite" />
            <Spinner
                android:id="@+id/stock_detail_range"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/stock_detail_chart_range" />
            <TextView
                android:id="@+id/stock_detail_chart_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:accessibilityLiveRegion="polite" />
            <ImageView
                android:id="@+id/stock_detail_chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/stock_detail_trend_chart"
                android:visibility="gone" />
            <TextView
                android:id="@+id/stock_detail_chart_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
            <Button
                android:id="@+id/stock_detail_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/stock_detail_refresh" />
            <TextView
                android:id="@+id/stock_detail_news_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/stock_detail_news_title"
                android:textStyle="bold"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/stock_detail_news_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:accessibilityLiveRegion="polite" />
            <LinearLayout
                android:id="@+id/stock_detail_news"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/stock_detail_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/stock_detail_notice"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
